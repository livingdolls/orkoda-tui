{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orkoda API Envelope",
  "type": "object",
  "properties": {
    "data": {},
    "meta": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["code", "message", "details"]
    },
    "request_id": { "type": "string" }
  }
}
