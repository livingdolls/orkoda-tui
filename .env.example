ORKODA_ENV=development
ORKODA_LOG_LEVEL=debug
ORKODA_API_HOST=127.0.0.1
ORKODA_API_PORT=8181
ORKODA_SHUTDOWN_TIMEOUT=10s

POSTGRES_DB=orkoda
POSTGRES_USER=orkoda
POSTGRES_PASSWORD=orkoda_dev
DATABASE_URL=postgres://orkoda:orkoda_dev@127.0.0.1:5432/orkoda?sslmode=disable

REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_DEFAULT_USER=orkoda
RABBITMQ_DEFAULT_PASS=orkoda_dev
RABBITMQ_URL=amqp://orkoda:orkoda_dev@127.0.0.1:5672/

MINIO_ROOT_USER=orkoda
MINIO_ROOT_PASSWORD=orkoda_dev_password
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=orkoda-artifacts
S3_ACCESS_KEY=orkoda
S3_SECRET_KEY=orkoda_dev_password
S3_USE_PATH_STYLE=true
